rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // المواد: الكل يقرأ، الأدمن بس بيعدّل
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // بيانات المستخدمين
    match /users/{userId} {
      // كل طالب بيقرأ بياناته هو بس
      allow read: if isSelf(userId);
      // الطالب بينشئ ويعدّل بياناته، بس ما بيقدر يعطي حاله صلاحية أدمن
      allow create: if isSelf(userId)
                    && request.resource.data.get('role', null) == null;
      allow update: if isSelf(userId)
                    && request.resource.data.get('role', null) == resource.data.get('role', null);
      // الأدمن بيشوف قائمة كل المستخدمين
      allow list: if isAdmin();
    }

    // الدروس
    match /lessons/{lessonId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // الأدمن بيعدّل أي إشي؛ الطالب بيربط التحدي بالدرس أول مرة بس (حقل challengeId لحاله)
      allow update: if isAdmin()
                    || (signedIn()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['challengeId']));
    }

    // التحديات
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // حلول الطلاب
    match /solutions/{solutionId} {
      // الطالب بيسجّل حل باسمه هو بس
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      // الطالب بيقرأ ويحدّث حله هو بس
      allow read, update: if signedIn()
                          && resource.data.userId == request.auth.uid;
      // الأدمن بيشوف كل الحلول
      allow list: if isAdmin();
    }

    // المحادثات مع دلتا
    match /conversations/{conversationId} {
      allow read, update: if signedIn()
                          && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, create: if signedIn()
                            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
      }
    }
  }
}
